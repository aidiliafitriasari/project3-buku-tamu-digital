# Blokir eksekusi script di folder upload
<FilesMatch "\.(php|php3|php4|php5|php7|php8|phtml|pl|py|jsp|asp|sh|cgi|exe)$">
    Require all denied
</FilesMatch>

# Blokir akses ke file sensitif
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|inc|bak|sql|env)$">
    Require all denied
</FilesMatch>

# Matikan eksekusi PHP di folder ini
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Force download untuk file yang mencurigakan
<FilesMatch "\.(php|phtml|pl|py|jsp|asp|sh|cgi|exe)$">
    ForceType application/octet-stream
    Header set Content-Disposition "attachment"
</FilesMatch>